# =============================================================================
# OCPP Core — Configuration
# Copy to .env and edit for your deployment.
# All values have safe defaults; only PG_PASSWORD is required.
# =============================================================================

# ── Database (PostgreSQL 16+ with TimescaleDB) ────────────────────────────────
PG_HOST=127.0.0.1
PG_PORT=5432
PG_NAME=ocpp
PG_USER=ocpp
PG_PASSWORD=changeme

# Connection pool size
PG_POOL_MIN=5
PG_POOL_MAX=20

# Read replica (optional — leave empty to use primary for all reads)
PG_REPLICA_HOST=
PG_REPLICA_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

# ── OCPP WebSocket Servers ────────────────────────────────────────────────────
OCPP16_HOST=0.0.0.0
OCPP16_PORT=9100
# Chargers connect to: ws://your-host:9100/ocpp/{charger-id}

OCPP201_HOST=0.0.0.0
OCPP201_PORT=9201
# Chargers connect to: ws://your-host:9201/ocpp/{charger-id}

# How often to ask chargers for a heartbeat (seconds)
OCPP_HEARTBEAT_INTERVAL=60

# MeterValues batching (aggregate before writing to DB for performance)
OCPP_METER_BATCH_INTERVAL=2.0   # seconds between flushes
OCPP_METER_BATCH_SIZE=100       # max records per flush

# ── REST API ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# API key for protected endpoints (leave empty to disable authentication)
API_KEY=

# Comma-separated list of allowed CORS origins (* = allow all)
CORS_ORIGINS=*

# ── PKI (Built-in Certificate Authority) ─────────────────────────────────────
# Where to store CA keys and issued certificates
PKI_DATA_DIR=./data/pki

# Organization name embedded in all CA certificates
PKI_ORG_NAME=OCPP Core

# Certificate distinguished names
PKI_ROOT_CA_CN=OCPP Core Root CA
PKI_USER_CA_CN=OCPP Core User CA

# Passwords to encrypt CA private keys (leave empty for no encryption)
# Set these for production deployments!
PKI_ROOT_CA_PASSWORD=
PKI_SUB_CA_PASSWORD=

# Validity period for issued leaf certificates (days)
PKI_CERT_VALIDITY_DAYS=365

# OCSP responder port
PKI_OCSP_PORT=8099

# ── OCPI 2.2.1 (Roaming) ────────────────────────────────────────────────────
# Public base URL for OCPI endpoints (what roaming partners will connect to)
OCPI_BASE_URL=http://localhost:8000

# Your CPO identity shown to roaming partners
OCPI_OPERATOR_NAME=OCPP Core CPO
OCPI_OPERATOR_WEBSITE=https://your-cpo-website.example.com

# 3-letter OCPI party identifier (must be unique per network)
OCPI_PARTY_ID=OCP

# 2-letter ISO 3166-1 alpha-2 country code
OCPI_COUNTRY_CODE=NL

# ── Charger Profiles ──────────────────────────────────────────────────────────
# Optional: path to a YAML file with custom charger profiles
# See charger_profiles/examples.py and README.md for format
CHARGER_PROFILES_YAML=

# Set to true to disable the built-in example profiles (Maxpower, Hongjiali, etc.)
# Useful if you want a clean slate and only load your own profiles
CHARGER_PROFILES_NO_EXAMPLES=false

# ── Tailscale (optional) ──────────────────────────────────────────────────────
# Zero-trust networking for distributed charger sites
TAILSCALE_ENABLED=false
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=
TAILSCALE_GATEWAY_TAG=tag:charger-gw

# ── Event Bus (Redis Streams) ─────────────────────────────────────────────────
# Prefix for all Redis stream keys
EVENTS_STREAM_PREFIX=ocpp

# Max events to retain per stream (older events are trimmed)
EVENTS_MAX_STREAM_LENGTH=100000

# How long consumers wait for new events before checking again (ms)
EVENTS_CONSUMER_BLOCK_MS=5000

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log format: json (structured, for log aggregators) | text (human-readable)
LOG_FORMAT=json

# ── Operator Branding ─────────────────────────────────────────────────────────
# Shown in PDFs, receipts, invoices, and SMS messages
OPERATOR_NAME=Your CPO
OPERATOR_EMAIL=info@example.com
OPERATOR_URL=https://example.com

# ── Charge App (driver-facing web app) ───────────────────────────────────────
# Base URL of your charge app (for QR links, SMS, payment redirects)
CHARGE_APP_URL=http://localhost:8080

# ── Payments (Mollie) ─────────────────────────────────────────────────────────
# Webhook URL for iDEAL payment status callbacks
PAYMENT_WEBHOOK_URL=http://localhost:8000/api/payments/webhook

# Webhook URL for SEPA Direct Debit mandate callbacks
SEPA_MANDATE_WEBHOOK_URL=http://localhost:8000/api/payments/mandate-webhook

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# mailto: address for VAPID claims (required by Web Push spec)
VAPID_EMAIL=mailto:admin@example.com

# Generate VAPID keys with:
#   openssl ecparam -genkey -name prime256v1 | openssl ec -out vapid_private.pem
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ── Simulated Chargers ────────────────────────────────────────────────────────
# Vendor string that marks a charger as simulated (for test/CI chargers)
SIMULATED_VENDOR=VIRTUAL_CHARGER

# ── Lago Billing (optional) ───────────────────────────────────────────────────
# Leave empty to disable Lago billing integration entirely
LAGO_API_KEY=
LAGO_API_URL=https://api.getlago.com

# Suffix appended to external_id when looking up Lago subscriptions
LAGO_SUBSCRIPTION_SUFFIX=fleet_001
